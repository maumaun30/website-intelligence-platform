# Copy to `.env` beside docker-compose.yml and fill in. The api and worker both read this file;
# DATABASE_URL and REDIS_URL are set by docker-compose.yml, so they are not here.

# Image tag to run: `latest`, or a commit SHA to pin or roll back.
IMAGE_TAG=latest
# Loopback port the reverse proxy forwards to. Change it if another app on the droplet has 4000.
API_HOST_PORT=4000

# Generate with `openssl rand -hex 24`. Changing it later means updating the database user too.
POSTGRES_PASSWORD=

# --- Shared ---
APP_URL=https://example.com

# --- API ---
# Generate with `openssl rand -base64 32`. Not the development one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.example.com
AUTH_COOKIE_DOMAIN=.example.com
CORS_ORIGINS=https://example.com
AI_EXPLANATIONS_ENABLED=true
STRIPE_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Social sign-in. Set both halves of a pair or neither, and leave unused ones commented out: an
# empty value is not the same as unset, and the API refuses to boot on it.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Worker ---
WORKER_CONCURRENCY=3
# MUST stay false: with it on, anyone can scan an internal address and read the response back.
ALLOW_PRIVATE_SCAN_TARGETS=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_FROM=Wintel <no-reply@example.com>
ANTHROPIC_API_KEY=
AI_EXPLANATION_PROVIDER=anthropic

# --- Error tracking, both apps (optional) ---
# Leave SENTRY_DSN commented out to report nowhere: an empty value fails validation at boot.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
