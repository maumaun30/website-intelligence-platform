# Shared local infrastructure (see docker-compose.yml)
DATABASE_URL="postgresql://wintel:wintel@localhost:5433/wintel?schema=public"
REDIS_URL="redis://localhost:6380"

# Auth (API). Required, no default: min 32 characters. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-generated-secret-at-least-32-chars"

# AI explanations (optional). API gate; worker key and provider.
# AI_EXPLANATIONS_ENABLED=true
# ANTHROPIC_API_KEY=
# AI_EXPLANATION_PROVIDER=anthropic

# Stripe. STRIPE_PROVIDER=fake keeps development offline; `stripe` requires all four values.
STRIPE_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Social sign-in (optional). A provider only appears on the sign-in page when BOTH halves are set;
# setting just one fails at boot rather than dropping the provider silently.
# Callback URL to register with each provider:
#   http://localhost:4000/api/v1/auth/callback/github
#   http://localhost:4000/api/v1/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only. Lets the crawler and verifier reach loopback and private addresses so a test
# site on localhost can be scanned. MUST stay false in production: with it on, anyone can point a
# website at an internal address and read the response back out of the stored scan.
ALLOW_PRIVATE_SCAN_TARGETS=false

# Transactional email. `smtp` (the default) delivers into the local Mailpit container; production
# uses `resend`, which posts to Resend's HTTP API instead — hosts commonly block outbound SMTP,
# and an HTTP failure says why. The worker refuses to boot on `resend` without a key, rather than
# dropping verification and invitation mail on the floor.
# SMTP_FROM is the sender for both, and its domain must be verified with the provider.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
