# Shared local infrastructure (see docker-compose.yml)
DATABASE_URL="postgresql://wintel:wintel@localhost:5433/wintel?schema=public"
REDIS_URL="redis://localhost:6380"

# Auth (API). Required, no default: min 32 characters. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-generated-secret-at-least-32-chars"

# AI explanations (optional). API gate; worker key and provider.
# AI_EXPLANATIONS_ENABLED=true
# ANTHROPIC_API_KEY=
# AI_EXPLANATION_PROVIDER=anthropic

# Stripe. STRIPE_PROVIDER=fake keeps development offline; `stripe` requires all four values.
STRIPE_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
