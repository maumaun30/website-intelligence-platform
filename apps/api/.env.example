NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
# Required, no default: min 32 characters. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-generated-secret-at-least-32-chars
